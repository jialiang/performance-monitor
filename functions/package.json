{
  "name": "functions",
  "version": "0.0.0",
  "scripts": {
    "lint": "eslint .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "clone": "npm run build && node scripts/clone.mjs",
    "clone:aws": "npm run build && node aws/clone.mjs",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "env.jsonc",
    "aws/handler.mjs",
    "aws/google-credentials.json"
  ],
  "dependencies": {
    "@google-cloud/bigquery-storage": "^6.3.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^11.3.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "globals": "17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "private": true
}
