{
  // REQUIRED:

  // Shown on the Google Cloud console's welcome page.
  "PROJECT_NUMBER": "123456789012",

  "HOSTNAME": "https://google.com",

  // Regions that Firebase would deploy to.
  "DEPLOY_REGIONS": ["us-central1", "us-east4", "us-west2"],

  // Regions that get triggered to run.
  // Generally should be a superset of DEPLOY_REGIONS.
  // Additional regions to be added when you add deployments manually.
  "CALL_REGIONS": ["us-central1", "us-east4", "us-west2", "asia-northeast1"]

  // OPTIONAL:

  // Each falls back to the project's default compute account.
  // That account may have broad access (Editor in older projects).
  // "SCHEDULER_SERVICE_ACCOUNT": "service-account@project-1234.iam.gserviceaccount.com",
  // "FUNCTION_SERVICE_ACCOUNT": "service-account@project-1234.iam.gserviceaccount.com",

  // Log results to BigQuery.
  // "BIGQUERY_PROJECT": "project-1234",
  // "BIGQUERY_DATASET": "monitoring",
  // "BIGQUERY_TABLE": "connections",

  // The list of resources to fetch is not set here: it lives in Remote Config so it
  // can change without a deploy. See the readme.
}
