{
  // REQUIRED:

  "SCHEDULER_SERVICE_ACCOUNT": "service-account@project-1234.iam.gserviceaccount.com",
  "FUNCTION_SERVICE_ACCOUNT": "service-account@project-1234.iam.gserviceaccount.com",

  "HOSTNAME": "https://google.com",

  "RESOURCES": [
    { "path": "/", "label": "index" },
    { "path": "/path/to/resource/1", "label": "resource 1", "logToDatabase": true },
    { "path": "/path/to/resource/2", "label": "resource 2" },
    { "path": "/path/to/resource/3", "label": "resource 3" }
  ],

  "REGIONS": ["us-central1", "us-east4", "us-west2"]

  // OPTIONAL — log results to BigQuery.
  // Omit BIGQUERY_DATASET to disable logging entirely.

  // "BIGQUERY_PROJECT": "project-1234",
  // "BIGQUERY_DATASET": "monitoring",
  // "BIGQUERY_TABLE": "connections"
}
